{
  "name": "@confeccao/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "simular": "tsx src/scripts/simular-conversa.ts",
    "db:seed:prod": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/static": "^10.1.11",
    "@prisma/client": "^6.19.3",
    "baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
