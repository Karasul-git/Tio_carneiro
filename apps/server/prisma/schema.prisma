generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTOR
  ATENDENTE
}

/// Status da conexão de um número de WhatsApp
enum ConnectionStatus {
  DISCONNECTED // parado / nunca conectado
  CONNECTING // abrindo conexão
  QR // aguardando leitura do QR Code
  CONNECTED // online
  LOGGED_OUT // sessão encerrada no celular, precisa de novo QR
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/// Quem originou a mensagem
/// Etapa do robô de triagem na conversa
enum BotState {
  NONE // robô ainda não atuou nesta sessão
  MENU // aguardando escolha no menu
  COLLECTING // coletando detalhes (ex.: orçamento) antes de passar ao atendente
  FAQ // respondendo dúvidas pela base de respostas
  HANDOFF // passou para um humano, aguardando o atendente
  HUMAN // atendente assumiu; robô fica quieto até a próxima sessão
}

enum MessageSender {
  CUSTOMER // cliente
  ATTENDANT_PHONE // atendente pelo celular (WhatsApp do aparelho)
  PANEL // enviada pelo painel/app
  BOT // robô (fase 2)
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ATENDENTE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connections       WhatsAppConnection[]
  pushSubscriptions PushSubscription[]
  sentMessages      Message[]
  createdOrders     Order[]
}

model WhatsAppConnection {
  id          String           @id @default(cuid())
  name        String // ex.: "Maria - Vendas"
  phone       String? // preenchido ao conectar
  status      ConnectionStatus @default(DISCONNECTED)
  attendantId String?
  attendant   User?            @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  lastError   String?
  connectedAt DateTime?
  /// Robô de triagem ligado para este número (além da chave geral)
  botEnabled  Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  contacts      Contact[]
  conversations Conversation[]
  orders        Order[]
}

model Contact {
  id           String             @id @default(cuid())
  connectionId String
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// JID usado para enviar mensagens (pode ser @s.whatsapp.net ou @lid)
  jid          String
  phone        String?
  name         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  conversations Conversation[]
  /// Cadastro de cliente (preenchido quando o cliente faz um pedido)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([connectionId, jid])
}

model Conversation {
  id              String             @id @default(cuid())
  connectionId    String
  connection      WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status          ConversationStatus @default(OPEN)
  /// Momento da mensagem mais antiga do cliente ainda sem resposta (null = respondida)
  awaitingSince   DateTime?
  lastMessageAt   DateTime?
  lastMessageText String?
  unreadCount     Int                @default(0)

  // ---- Triagem (Fase 2) ----
  botState             BotState  @default(NONE)
  /// Início da sessão de atendimento atual (uma nova começa após um tempo sem conversa)
  sessionStartedAt     DateTime?
  botMessagesInSession Int       @default(0)
  /// Assunto identificado: orcamento, pedido, acompanhamento, duvida, troca, pagamento...
  intent               String?
  /// Resumo para o atendente
  summary              String?
  summaryUpdatedAt     DateTime?
  handoffAt            DateTime?
  handoffReason        String?
  /// Dados da triagem da sessão (opção escolhida, respostas dadas, sugestões...)
  triage               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  orders   Order[]

  @@unique([connectionId, contactId])
  @@index([awaitingSince])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// ID da mensagem no WhatsApp
  waMessageId    String
  fromMe         Boolean
  sender         MessageSender
  sentByUserId   String?
  sentByUser     User?         @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  type           String // text, image, audio, video, document, sticker, location, contact, other
  body           String?
  /// Informações extras (ex.: resposta da base usada pelo robô e a confiança)
  meta           Json?
  timestamp      DateTime
  createdAt      DateTime      @default(now())

  @@unique([conversationId, waMessageId])
  @@index([conversationId, timestamp])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Base de respostas (perguntas frequentes, tabelas, prazos...) usada pelo robô
model KnowledgeItem {
  id        String   @id @default(cuid())
  /// Pergunta principal, como o cliente costuma escrever
  question  String
  /// Outras formas de perguntar / palavras-chave (uma por item)
  variants  String[] @default([])
  answer    String
  category  String?
  active    Boolean  @default(true)
  /// Quantas vezes o robô usou esta resposta
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Configurações gerais do sistema (chave/valor)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ======================= Fase 3: catálogo, clientes e pedidos =======================

model Product {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  category           String?
  sku                String?
  /// Preço em centavos (null = sob orçamento)
  priceCents         Int?
  /// Grade de tamanhos (ex.: P, M, G, GG)
  sizes              String[] @default([])
  colors             String[] @default([])
  /// Acréscimo em centavos por tamanho (ex.: {"GG": 500, "XG": 800})
  sizeSurchargeCents Json?
  /// Quantidade mínima por pedido deste produto
  minQuantity        Int      @default(1)
  /// Aceita personalização (estampa, bordado, logo)
  customizable       Boolean  @default(false)
  imageUrl           String?
  active             Boolean  @default(true)
  position           Int      @default(0)

  // Dados fiscais (para a nota fiscal na fase 6)
  ncm    String?
  cfop   String?
  /// Origem da mercadoria (0 = nacional)
  origin Int?    @default(0)
  unit   String  @default("UN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

enum PersonType {
  PF
  PJ
}

model Customer {
  id                String     @id @default(cuid())
  name              String
  personType        PersonType @default(PF)
  /// CPF ou CNPJ, só dígitos
  document          String?    @unique
  /// Inscrição estadual (PJ)
  stateRegistration String?
  email             String?
  phone             String?
  zipCode           String?
  street            String?
  number            String?
  complement        String?
  district          String?
  city              String?
  state             String?
  /// Código IBGE do município (usado na nota fiscal)
  cityCode          String?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  contacts Contact[]
  orders   Order[]
}

enum OrderStatus {
  DRAFT // link enviado, cliente ainda montando
  SUBMITTED // cliente enviou pelo link
  CONFIRMED // confirmado pela confecção
  IN_PRODUCTION
  READY // pronto para entrega/retirada
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

model Order {
  id             String              @id @default(cuid())
  /// Número exibido para o cliente (#1001, #1002...)
  number         Int                 @unique @default(autoincrement())
  /// Código secreto do link público do pedido
  token          String              @unique
  status         OrderStatus         @default(DRAFT)
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  connectionId   String?
  connection     WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// Dados que o cliente informou no link (antes de virar cadastro)
  customerData   Json?
  deliveryMethod DeliveryMethod @default(PICKUP)
  /// Prazo desejado pelo cliente
  desiredDate    DateTime?
  /// Prazo combinado pela confecção
  dueDate        DateTime?
  customerNotes  String?
  internalNotes  String?

  discountCents Int @default(0)
  shippingCents Int @default(0)
  /// Total calculado (itens - desconto + frete)
  totalCents    Int @default(0)

  submittedAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([conversationId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Nome do produto no momento do pedido
  description    String
  size           String?
  color          String?
  quantity       Int
  /// Preço unitário em centavos (já com acréscimo de tamanho); null = a definir
  unitPriceCents Int?
  customization  String?
  position       Int      @default(0)
}
