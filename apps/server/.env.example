# Banco de dados PostgreSQL
DATABASE_URL="postgresql://confeccao:confeccao@localhost:5432/confeccao?schema=public"

# Porta da API
PORT=3333

# Segredo para assinar os tokens de login (troque em produção!)
JWT_SECRET="troque-este-segredo"

# Origem(ns) do app web, separadas por vírgula (CORS)
WEB_ORIGIN="http://localhost:5173"

# Pasta onde ficam as sessões do WhatsApp (uma subpasta por número)
SESSIONS_DIR="./sessions"

# Limite de números conectados
MAX_CONNECTIONS=5

# Notificações push (opcional). Se vazio, as chaves são geradas e salvas no banco.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Pasta com o build do app web para servir junto da API (opcional)
WEB_DIST_DIR=""

# Administrador inicial (usado por npm run db:seed)
SEED_ADMIN_EMAIL="admin@confeccao.local"
SEED_ADMIN_PASSWORD="admin123"

# Resumo com IA (opcional). Sem chave, o resumo é feito por regras.
ANTHROPIC_API_KEY=""
# Modelo usado no resumo (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=""

# Endereço público usado no link de pedido enviado aos clientes.
# Vazio = usa o primeiro endereço de WEB_ORIGIN.
PUBLIC_URL=""
