# Domínio apontando para o servidor (ex.: atendimento.suaconfeccao.com.br)
DOMAIN=
# E-mail do administrador (também usado no certificado e nas notificações push)
ADMIN_EMAIL=
# Senha inicial do administrador (troque no app depois do primeiro acesso)
ADMIN_INITIAL_PASSWORD=
# Senhas/segredos longos e aleatórios (ex.: openssl rand -hex 32)
POSTGRES_PASSWORD=
JWT_SECRET=
# Opcional: resumo com IA (Claude). Deixe vazio para usar o resumo por regras.
ANTHROPIC_API_KEY=
MAX_CONNECTIONS=5
